PORT=4000
USE_MOCK_DB=false

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Domain gọi món khách hàng (Khi gắn domain mới chỉ cần thay đổi tại đây)
ORDER_BASE_URL="http://localhost:3001"

# Tài khoản khởi tạo Super Admin (Dùng cho npm run db:seed)
SUPER_ADMIN_SEED_EMAIL="admin@a2order.vn"
SUPER_ADMIN_SEED_PASSWORD="A2OrderAdminPassword2026!"
SEED_DUMMY_STORES=true
