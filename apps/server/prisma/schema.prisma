generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  phone         String?
  address       String?
  bankAccount   String?
  bankBin       String?
  bankOwnerName String?
  status        String            @default("ACTIVE")
  configVersion String            @default("v1.0.0")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  auditLogs     AuditLog[]
  bills         Bill[]
  categories    Category[]
  menuItems     MenuItem[]
  orderSessions OrderSession[]
  staff         Staff[]
  landingPage   StoreLandingPage?
  license       StoreLicense?
  telemetries   StoreTelemetry[]
  tables        Table[]
  tableZones    TableZone[]
}

model Staff {
  id           String     @id @default(uuid())
  storeId      String
  name         String
  email        String?    @unique
  passwordHash String?
  pinCode      String?
  role         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model TableZone {
  id        String  @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int     @default(0)
  tables    Table[]
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Table {
  id               String         @id @default(uuid())
  storeId          String
  zoneId           String
  name             String
  status           String         @default("EMPTY")
  qrSecret         String         @default(uuid())
  currentSessionId String?
  orderSessions    OrderSession[]
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone             TableZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Category {
  id        String     @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int        @default(0)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([storeId])
}

model MenuItem {
  id          String      @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  price       Int
  image       String?
  isAvailable Boolean     @default(true)
  station     String      @default("KITCHEN")
  createdAt   DateTime    @default(now())
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId])
}

model OrderSession {
  id         String       @id @default(uuid())
  storeId    String
  tableId    String
  status     String       @default("ACTIVE")
  checkInAt  DateTime     @default(now())
  checkOutAt DateTime?
  bills      Bill[]
  batches    OrderBatch[]
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table      Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([tableId])
}

model OrderBatch {
  id             String       @id @default(uuid())
  orderSessionId String
  batchNumber    Int          @default(1)
  isCustomerQr   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  items          OrderItem[]
}

model OrderItem {
  id           String     @id @default(uuid())
  orderBatchId String
  menuItemId   String
  quantity     Int
  price        Int
  notes        String?
  status       String     @default("QUEUED")
  createdAt    DateTime   @default(now())
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  orderBatch   OrderBatch @relation(fields: [orderBatchId], references: [id], onDelete: Cascade)
}

model Bill {
  id              String       @id @default(uuid())
  storeId         String
  orderSessionId  String
  totalAmount     Int
  discountAmount  Int          @default(0)
  finalAmount     Int
  paymentMethod   String       @default("CASH")
  paymentStatus   String       @default("PENDING")
  transactionCode String?
  createdAt       DateTime     @default(now())
  orderSession    OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  staffId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  staff     Staff?   @relation(fields: [staffId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model StoreLicense {
  id             String            @id @default(uuid())
  storeId        String            @unique
  licenseKey     String            @unique
  planType       String            @default("PRO")
  enabledModules String            @default("CORE_POS,MODULE_KDS,MODULE_ACCOUNTING,MODULE_QR_ORDER,MODULE_ADVANCED_ANALYTICS")
  status         String            @default("ACTIVE")
  startDate      DateTime          @default(now())
  endDate        DateTime
  maxTables      Int               @default(30)
  maxStaff       Int               @default(20)
  autoRenew      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  invoices       SoftwareInvoice[]
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model SoftwareInvoice {
  id             String       @id @default(uuid())
  storeLicenseId String
  invoiceCode    String       @unique
  amount         Int
  durationMonths Int
  periodStart    DateTime
  periodEnd      DateTime
  status         String       @default("PENDING")
  paymentMethod  String       @default("VIETQR")
  transactionRef String?
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  license        StoreLicense @relation(fields: [storeLicenseId], references: [id], onDelete: Cascade)
}

model StoreTelemetry {
  id            String   @id @default(uuid())
  storeId       String
  pingMs        Int
  activeSockets Int
  clientIp      String?
  userAgent     String?
  recordedAt    DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, recordedAt])
}

model StoreLandingPage {
  id            String   @id @default(uuid())
  storeId       String   @unique
  customDomain  String?  @unique
  slug          String   @unique
  heroTitle     String
  heroSubtitle  String?
  heroBannerUrl String?
  storyContent  String?
  openingHours  String?  @default("06:00 - 22:00")
  hotline       String?
  address       String?
  googleMapsUrl String?
  facebookUrl   String?
  zaloPhone     String?
  isBookingOpen Boolean  @default(true)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
