datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. NHÀ HÀNG / QUÁN ĂN (TENANT)
model Store {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  phone         String?
  address       String?
  bankAccount   String?   // Số tài khoản ngân hàng nhận tiền VietQR
  bankBin       String?   // Mã ngân hàng Napas
  bankOwnerName String?   // Tên chủ tài khoản
  status        String    @default("ACTIVE") // ACTIVE, TRIAL, SUSPENDED
  configVersion String    @default("v1.0.0") // Quản lý phiên bản snapshot cấu hình quán
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff[]
  tableZones    TableZone[]
  tables        Table[]
  categories    Category[]
  menuItems     MenuItem[]
  orderSessions OrderSession[]
  bills         Bill[]
  auditLogs     AuditLog[]
  license       StoreLicense?
  landingPage   StoreLandingPage?
  telemetries   StoreTelemetry[]
}

// 2. NHÂN VIÊN & PHÂN QUYỀN RBAC
model Staff {
  id           String    @id @default(uuid())
  storeId      String
  name         String
  email        String?   @unique
  passwordHash String?
  pinCode      String?   // 4 số cho nhân viên bàn/bếp
  role         String    // SUPER_ADMIN, STORE_OWNER, ACCOUNTANT, CASHIER, CHEF, WAITER
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([storeId])
}

// 3. KHU VỰC BÀN (TẦNG 1, TẦNG 2, SÂN VƯỜN)
model TableZone {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int      @default(0)

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tables    Table[]

  @@index([storeId])
}

// 4. BÀN ĂN & MÃ QR
model Table {
  id               String    @id @default(uuid())
  storeId          String
  zoneId           String
  name             String
  status           String    @default("EMPTY") // EMPTY, OCCUPIED, WAITING_FOOD, SERVED, PAYMENT_PENDING
  qrSecret         String    @default(uuid())  // Token sinh mã QR chống phá hoại
  currentSessionId String?

  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone             TableZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orderSessions    OrderSession[]

  @@index([storeId])
}

// 5. DANH MỤC MÓN ĂN
model Category {
  id        String     @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int        @default(0)

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([storeId])
}

// 6. MÓN ĂN & ĐỒ UỐNG
model MenuItem {
  id          String      @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  price       Int
  image       String?
  isAvailable Boolean     @default(true) // Nút 86 bật/tắt hết món của bếp
  station     String      @default("KITCHEN") // KITCHEN hoặc BAR
  createdAt   DateTime    @default(now())

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId])
}

// 7. PHIÊN ĂN CỦA BÀN
model OrderSession {
  id          String       @id @default(uuid())
  storeId     String
  tableId     String
  status      String       @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  checkInAt   DateTime     @default(now())
  checkOutAt  DateTime?

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table       Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  batches     OrderBatch[]
  bills       Bill[]

  @@index([storeId])
  @@index([tableId])
}

// 8. ĐỢT GỌI MÓN (ĐỢT 1, ĐỢT 2, GỌI THÊM)
model OrderBatch {
  id             String       @id @default(uuid())
  orderSessionId String
  batchNumber    Int          @default(1)
  isCustomerQr   Boolean      @default(false)
  createdAt      DateTime     @default(now())

  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  items          OrderItem[]
}

// 9. CHI TIẾT MÓN ĐƯỢC GỌI
model OrderItem {
  id           String      @id @default(uuid())
  orderBatchId String
  menuItemId   String
  quantity     Int
  price        Int         // Giá lưu tại thời điểm gọi món (Server-side)
  notes        String?
  status       String      @default("QUEUED") // QUEUED, COOKING, DONE, SERVED, CANCELLED
  createdAt    DateTime    @default(now())

  orderBatch   OrderBatch  @relation(fields: [orderBatchId], references: [id], onDelete: Cascade)
  menuItem     MenuItem    @relation(fields: [menuItemId], references: [id])
}

// 10. HÓA ĐƠN & THANH TOÁN VIETQR
model Bill {
  id              String       @id @default(uuid())
  storeId         String
  orderSessionId  String
  totalAmount     Int
  discountAmount  Int          @default(0)
  finalAmount     Int
  paymentMethod   String       @default("CASH") // CASH, VIETQR, CARD
  paymentStatus   String       @default("PENDING") // PENDING, PAID, FAILED
  transactionCode String?      // Mã đối soát VietQR
  createdAt       DateTime     @default(now())

  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderSession    OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// 11. NHẬT KÝ KIỂM TOÁN CHỐNG GIAN LẬN NỘI BỘ
model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  staffId   String?
  action    String   // CANCEL_ITEM, DISCOUNT_BILL, MERGE_TABLE
  details   String?  // JSON string
  createdAt DateTime @default(now())

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staff     Staff?   @relation(fields: [staffId], references: [id])

  @@index([storeId])
}

// 12. GÓI BẢN QUYỀN & THỜI HẠN THUÊ PHẦN MỀM
model StoreLicense {
  id              String            @id @default(uuid())
  storeId         String            @unique
  licenseKey      String            @unique // vd: A2-PRO-2026-X89F2A
  planType        String            @default("PRO") // TRIAL, BASIC, PRO, ENTERPRISE
  enabledModules  String            @default("CORE_POS,MODULE_KDS,MODULE_ACCOUNTING,MODULE_QR_ORDER,MODULE_ADVANCED_ANALYTICS") // Danh sách module kích hoạt, phân tách bằng dấu phẩy
  status          String            @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, SUSPENDED
  startDate       DateTime          @default(now())
  endDate         DateTime          // Ngày hết hạn thuê phần mềm
  maxTables       Int               @default(30)
  maxStaff        Int               @default(20)
  autoRenew       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices        SoftwareInvoice[]
}

// 13. HÓA ĐƠN THUÊ PHẦN MỀM GIỮA CHỦ QUÁN VÀ A2ORDER PLATFORM
model SoftwareInvoice {
  id              String            @id @default(uuid())
  storeLicenseId  String
  invoiceCode     String            @unique // vd: INV-2026-0012
  amount          Int               // Số tiền thuê (VND)
  durationMonths  Int               // Thời gian thuê (1, 6, 12 tháng)
  periodStart     DateTime
  periodEnd       DateTime
  status          String            @default("PENDING") // PENDING, PAID, CANCELLED
  paymentMethod   String            @default("VIETQR")
  transactionRef  String?
  paidAt          DateTime?
  pdfUrl          String?
  createdAt       DateTime          @default(now())

  license         StoreLicense      @relation(fields: [storeLicenseId], references: [id], onDelete: Cascade)
}

// 14. GIÁM SÁT HẠ TẦNG & TỐC ĐỘ ĐƯỜNG TRUYỀN (SUPER ADMIN TELEMETRY)
model StoreTelemetry {
  id              String            @id @default(uuid())
  storeId         String
  pingMs          Int               // Độ trễ WebSocket round-trip
  activeSockets   Int               // Số thiết bị đang online tại quán
  clientIp        String?
  userAgent       String?
  recordedAt      DateTime          @default(now())

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, recordedAt])
}

// 15. LANDING PAGE & WEBSITE THƯƠNG HIỆU RIÊNG CHO TỪNG QUÁN
model StoreLandingPage {
  id              String            @id @default(uuid())
  storeId         String            @unique
  customDomain    String?           @unique // vd: "phobonamdinh.vn"
  slug            String            @unique // vd: "pho-bo-nam-dinh"
  heroTitle       String            // vd: "Phở Bò Gia Truyền Nam Định"
  heroSubtitle    String?           // vd: "Hương vị truyền thống 30 năm nước dùng đậm đà"
  heroBannerUrl   String?
  storyContent    String?           // Giới thiệu quán
  openingHours    String?           @default("06:00 - 22:00")
  hotline         String?
  address         String?
  googleMapsUrl   String?
  facebookUrl     String?
  zaloPhone       String?
  isBookingOpen   Boolean           @default(true)
  isPublished     Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
