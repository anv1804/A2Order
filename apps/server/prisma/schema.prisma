generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  phone         String?
  address       String?
  bankAccount   String?
  bankBin       String?
  bankOwnerName String?
  status        String            @default("ACTIVE")
  configVersion String            @default("v1.0.0")
  vatRate       Int               @default(8)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  auditLogs     AuditLog[]
  bills         Bill[]
  categories    Category[]
  menuItems     MenuItem[]
  orderSessions OrderSession[]
  staff         Staff[]
  landingPage   StoreLandingPage?
  license       StoreLicense?
  telemetries   StoreTelemetry[]
  tables        Table[]
  tableZones    TableZone[]
  documents     WorkspaceDocument[]
  commands      IdempotentCommand[]
  serviceRequests ServiceRequest[]
}

model Staff {
  id           String     @id @default(uuid())
  storeId      String
  name         String
  email        String?    @unique
  passwordHash String?
  pinCode      String?
  phone        String?
  shift        String @default("FULL_TIME")
  sessionVersion Int      @default(0)
  role         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@unique([id, storeId])
}

model TableZone {
  id        String  @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int     @default(0)
  tables    Table[]
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@unique([id, storeId])
}

model Table {
  id               String         @id @default(uuid())
  storeId          String
  zoneId           String
  name             String
  code             String?
  status           String         @default("EMPTY")
  qrSecret         String         @default(uuid())
  currentSessionId String?
  capacity         Int            @default(4)
  archivedAt       DateTime?
  orderSessions    OrderSession[]
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone             TableZone      @relation(fields: [zoneId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([storeId])
  @@index([zoneId])
  @@unique([id, storeId])
  @@unique([storeId, code])
}

model Category {
  id        String     @id @default(uuid())
  storeId   String
  name      String
  sortOrder Int        @default(0)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([storeId])
  @@unique([id, storeId])
}

model MenuItem {
  id          String      @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  price       Int
  costPrice   Int         @default(0)
  stockCount  Int?
  description String?
  isBestSeller Boolean   @default(false)
  variants    Json        @default("[]")
  modifiers   Json        @default("[]")
  customizationGroups Json @default("[]")
  majorCategory String?
  subCategory String?
  archivedAt  DateTime?
  image       String?
  isAvailable Boolean     @default(true)
  station     String      @default("KITCHEN")
  createdAt   DateTime    @default(now())
  category    Category    @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Restrict)
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([storeId])
  @@index([categoryId])
  @@unique([id, storeId])
}

model OrderSession {
  id         String       @id @default(uuid())
  storeId    String
  tableId    String
  status     String       @default("ACTIVE")
  checkInAt  DateTime     @default(now())
  checkOutAt DateTime?
  guestCount Int          @default(2)
  adjustments Json        @default("{}")
  bills      Bill[]
  batches    OrderBatch[]
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table      Table        @relation(fields: [tableId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([storeId])
  @@index([tableId])
  @@unique([id, storeId])
}

model OrderBatch {
  id             String       @id @default(uuid())
  orderSessionId String
  batchNumber    Int          @default(1)
  isCustomerQr   Boolean      @default(false)
  voucherCode String?
  discountAmount Int @default(0)
  promotionSnapshot Json @default("{}")
  status         String       @default("APPROVED")
  customerPhone  String?
  rejectionReason String?
  createdAt      DateTime     @default(now())
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  @@index([orderSessionId, createdAt])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderBatchId String
  menuItemId   String
  quantity     Int
  price        Int
  nameSnapshot String     @default("")
  costSnapshot Int        @default(0)
  station      String     @default("KITCHEN")
  optionSnapshot Json     @default("[]")
  notes        String?
  status       String     @default("QUEUED")
  createdAt    DateTime   @default(now())
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  orderBatch   OrderBatch @relation(fields: [orderBatchId], references: [id], onDelete: Cascade)
  @@index([orderBatchId])
  @@index([menuItemId])
}

model Bill {
  id              String       @id @default(uuid())
  storeId         String
  orderSessionId  String
  totalAmount     Int
  discountAmount  Int          @default(0)
  finalAmount     Int
  taxAmount       Int          @default(0)
  surchargeAmount Int          @default(0)
  discountPercent Int          @default(0)
  includeVat      Boolean      @default(false)
  discountReason  String?
  lineSnapshot    Json         @default("[]")
  paidAt          DateTime?
  cashierId       String?
  splitCount      Int          @default(1)
  paymentMethod   String       @default("CASH")
  paymentStatus   String       @default("PENDING")
  transactionCode String?
  createdAt       DateTime     @default(now())
  orderSession    OrderSession @relation(fields: [orderSessionId, storeId], references: [id, storeId], onDelete: Restrict)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([orderSessionId])
  @@index([storeId, paidAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  staffId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  staff     Staff?   @relation(fields: [staffId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([staffId])
}

model StoreLicense {
  id             String            @id @default(uuid())
  storeId        String?           @unique
  licenseKey     String            @unique
  planType       String            @default("PRO")
  enabledModules String            @default("CORE_POS,MODULE_KDS,MODULE_ACCOUNTING,MODULE_QR_ORDER,MODULE_ADVANCED_ANALYTICS")
  status         String            @default("ACTIVE")
  startDate      DateTime          @default(now())
  endDate        DateTime
  maxTables      Int               @default(30)
  maxStaff       Int               @default(20)
  autoRenew      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  invoices       SoftwareInvoice[]
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)
}

model SoftwareInvoice {
  id             String       @id @default(uuid())
  storeLicenseId String
  invoiceCode    String       @unique
  amount         Int
  durationMonths Int
  periodStart    DateTime
  periodEnd      DateTime
  status         String       @default("PENDING")
  paymentMethod  String       @default("VIETQR")
  transactionRef String?
  paidAt         DateTime?
  pdfUrl         String?
  voucherCode String?
  requestedModules String?
  createdAt      DateTime     @default(now())
  license        StoreLicense @relation(fields: [storeLicenseId], references: [id], onDelete: Cascade)
  @@index([storeLicenseId])
}

model StoreTelemetry {
  id            String   @id @default(uuid())
  storeId       String
  pingMs        Int
  activeSockets Int
  clientIp      String?
  userAgent     String?
  recordedAt    DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, recordedAt])
}

model StoreLandingPage {
  id            String   @id @default(uuid())
  storeId       String   @unique
  customDomain  String?  @unique
  slug          String   @unique
  heroTitle     String
  heroSubtitle  String?
  heroBannerUrl String?
  storyContent  String?
  openingHours  String?  @default("06:00 - 22:00")
  hotline       String?
  address       String?
  googleMapsUrl String?
  facebookUrl   String?
  zaloPhone     String?
  isBookingOpen Boolean  @default(true)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  key         String   @id
  value       String   @db.Text
  category    String   @default("PRICING")
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  billId         String
  storeId        String
  amount         Int
  method         String
  transactionRef String?  @unique
  partIndex      Int?
  createdAt      DateTime @default(now())
  bill           Bill     @relation(fields: [billId, storeId], references: [id, storeId], onDelete: Restrict)
  @@index([billId])
  @@unique([billId, partIndex])
  @@index([storeId, createdAt])
}

model IdempotentCommand {
  id          String   @id
  storeId     String
  actorId     String
  operation   String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId, createdAt])
}

model WorkspaceDocument {
  storeId   String
  key       String
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@id([storeId, key])
}

model ServiceRequest {
  id          String   @id @default(uuid())
  storeId     String
  tableId     String
  sessionId   String?
  type        String
  note        String?
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId, status, requestedAt])
}
