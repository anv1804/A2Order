{
  "name": "a2order",
  "version": "7.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Vận hành & Gọi món Thông minh cho Quán ăn / Nhà hàng vừa & nhỏ",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CMS,CLIENT\" -c \"cyan.bold,green.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:cms\" \"npm run dev:client\"",
    "start": "npm run dev",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:admin": "npm run dev:admin --workspace=apps/cms",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "pos",
    "fnb",
    "restaurant",
    "pwa",
    "vietqr",
    "realtime",
    "kds",
    "cms"
  ],
  "author": "A2Order Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
